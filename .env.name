# =============================================================
# AGENTICAI — Single .env for all apps
# Copy this file to .env and fill in your keys.
# Apps: nexus | athena | remedy | midas | odyssey | waypoint | agora
# =============================================================

# -------------------------------------------------------------
# LLM PROVIDERS — used by all apps
# -------------------------------------------------------------
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=                    # Gemini; all apps

# Base URL overrides (optional — leave blank for defaults)
GEMINI_BASE_URL=
GROQ_BASE_URL=
OPENROUTER_API_KEY=                # nexus (OpenRouter models)

# -------------------------------------------------------------
# SEARCH & WEB — nexus, athena, midas, waypoint
# -------------------------------------------------------------
# https://serper.dev/api-keys
SERPER_API_KEY=                    # athena (deep research web search)
# https://newsapi.org/v2/everything
NEWS_API_KEY=                      # nexus, midas (news agent)
# https://app.tavily.com/home
TAVILAY_API_KEY=                   # waypoint (Tavily web search)

# -------------------------------------------------------------
# MAPS & TRAVEL — waypoint
# -------------------------------------------------------------
# https://console.cloud.google.com — enable Places API
GPLACES_API_KEY=                   # waypoint (Google Places)
FOURSQUARE_API_KEY=                # waypoint (venue search)
OPENWEATHER_API_KEY=               # waypoint (weather data)
# https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=             # waypoint (currency conversion)
# https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=              # waypoint, midas (finance + currency data)

# -------------------------------------------------------------
# COMMUNICATION — nexus
# -------------------------------------------------------------
# https://app.sendgrid.com
SENDGRID_API_KEY=                  # nexus (email sending)

# -------------------------------------------------------------
# HUGGING FACE — all apps (model downloads & HF Spaces)
# -------------------------------------------------------------
HF_TOKEN=
HF_USERNAME=

# -------------------------------------------------------------
# LANGSMITH TRACING — all apps (optional)
# https://smith.langchain.com
# -------------------------------------------------------------
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# -------------------------------------------------------------
# LANGFUSE TRACING — nexus, athena (optional, local dev only)
# Leave unset on HuggingFace to disable tracing.
# http://localhost:3000/project/<id>/settings
# -------------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3000
