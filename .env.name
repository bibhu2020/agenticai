# =============================================================
# AGENTICAI — Single .env for all apps
# Copy this file to .env and fill in your keys.
# Apps: nexus | athena | remedy | midas | odyssey | waypoint | agora | news
# =============================================================

# -------------------------------------------------------------
# LLM PROVIDERS — used by all apps
# -------------------------------------------------------------
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=                    # Gemini; all apps

# Base URL overrides (optional — leave blank for defaults)
GEMINI_BASE_URL=
GROQ_BASE_URL=
OPENROUTER_API_KEY=                # nexus, news (OpenRouter — Claude Haiku 4.5 for daily news summarization)

# -------------------------------------------------------------
# SEARCH & WEB — nexus, athena, midas, waypoint
# -------------------------------------------------------------
# https://serper.dev/api-keys
SERPER_API_KEY=                    # athena (deep research web search)
# https://newsapi.org/v2/everything
NEWS_API_KEY=                      # nexus, midas (news agent)
# https://app.tavily.com/home
TAVILAY_API_KEY=                   # waypoint (Tavily web search)

# -------------------------------------------------------------
# MAPS & TRAVEL — waypoint
# -------------------------------------------------------------
# https://console.cloud.google.com — enable Places API
GPLACES_API_KEY=                   # waypoint (Google Places)
FOURSQUARE_API_KEY=                # waypoint (venue search)
OPENWEATHER_API_KEY=               # waypoint (weather data), news (Local tab: zip geocoding + weather)
# https://www.exchangerate-api.com
EXCHANGE_RATE_API_KEY=             # waypoint (currency conversion)
# https://www.alphavantage.co
ALPHAVANTAGE_API_KEY=              # waypoint, midas (finance + currency data)

# -------------------------------------------------------------
# COMMUNICATION — nexus
# -------------------------------------------------------------
# https://app.sendgrid.com
SENDGRID_API_KEY=                  # nexus (email sending)

# -------------------------------------------------------------
# HUGGING FACE — all apps (model downloads & HF Spaces)
# -------------------------------------------------------------
HF_TOKEN=
HF_USERNAME=

# -------------------------------------------------------------
# LANGSMITH TRACING — all apps (optional)
# https://smith.langchain.com
# -------------------------------------------------------------
LANGSMITH_TRACING=
LANGSMITH_ENDPOINT=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# -------------------------------------------------------------
# LANGFUSE TRACING — nexus, athena (optional, local dev only)
# Leave unset on HuggingFace to disable tracing.
# http://localhost:3000/project/<id>/settings
# -------------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=http://localhost:3000

# -------------------------------------------------------------
# GITHUB MEDIA REPO — fifa, news (push binary data to bibhu2020/media)
# Create a PAT at https://github.com/settings/tokens with repo scope
# news uses this to push daily Kokoro TTS audio (news/audio/**) so the
# main repo's git history doesn't grow by ~10-15MB every single day.
# -------------------------------------------------------------
GH_MEDIA_TOKEN=                # fifa (push/read fifa_data.xlsx), news (push daily TTS audio)

# -------------------------------------------------------------
# NEWS APP — admin force-trigger of the daily agent
# -------------------------------------------------------------
NEWS_ADMIN_PASSPHRASE=              # news (gates /api/admin/* — shared secret for bm80177@gmail.com)
# Fine-grained PAT scoped to bibhu2020/agenticai with "Actions: write" AND
# "Contents: write" permission (Contents: write is needed to commit
# src/news/data/config.json when the admin updates the Local tab's zip code)
# https://github.com/settings/personal-access-tokens/new
NEWS_TRIGGER_GH_TOKEN=              # news (workflow_dispatch on news-agent-daily.yml; commits local zip config)

# Text-to-speech (Kokoro-82M, local ONNX model — no key needed).
# Model files auto-download on first run to KOKORO_CACHE_DIR (default ~/.cache/kokoro).
# Leave both blank to use the defaults below.
KOKORO_VOICE=                        # news (optional — default: af_heart)
KOKORO_CACHE_DIR=                    # news (optional — default: ~/.cache/kokoro)
