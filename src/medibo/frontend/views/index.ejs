
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap">
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <div class="sidebar">
            <div class="logo">
                <span>⚡</span> MediBo
            </div>
            <div style="flex: 1;"></div>
            <div class="module-status" id="module-status">
                <div class="status-item">
                    <div class="status-label"><span>Perception Module</span> <span id="val-perception"><%= initialModules.perception %>%</span></div>
                    <div class="status-bar"><div class="status-fill" id="bar-perception" style="width: <%= initialModules.perception %>%; background: #3b82f6;"></div></div>
                </div>
                <div class="status-item">
                    <div class="status-label"><span>Cognitive Module</span> <span id="val-cognitive"><%= initialModules.cognitive %>%</span></div>
                    <div class="status-bar"><div class="status-fill" id="bar-cognitive" style="width: <%= initialModules.cognitive %>%; background: #8b5cf6;"></div></div>
                </div>
                <div class="status-item">
                    <div class="status-label"><span>Action Module</span> <span id="val-action"><%= initialModules.action %>%</span></div>
                    <div class="status-bar"><div class="status-fill" id="bar-action" style="width: <%= initialModules.action %>%; background: #10b981;"></div></div>
                </div>
                <div class="status-item">
                    <div class="status-label"><span>Security & Privacy</span> <span>100%</span></div>
                    <div class="status-bar"><div class="status-fill" style="width: 100%; background: #06b6d4;"></div></div>
                </div>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="chat-area">
            <div class="header">
                <h3>Symptom Triage Assistant</h3>
                <div class="patient-info">Patient: John Doe (ID: P001)</div>
            </div>
            
            <div class="messages" id="messages-container">
                <div class="message bot">
                    Hello! I am MediBo, your automated health triage assistant. How can I help you today?
                </div>
            </div>

            <div class="input-area">
                <input type="text" id="user-input" placeholder="Describe your symptoms..." autocomplete="off">
                <button id="send-btn">➤</button>
            </div>
        </div>
    </div>

    <script src="/js/client.js"></script>
</body>
</html>
